PORT=5000

MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d

SETUP_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SPA origin. On Vercel set this to https://your-app.vercel.app (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Public guest login ("Explore the live demo"). Set to false to switch it off.
DEMO_MODE_ENABLED=true

# --- Messaging (WhatsApp / SMS / e-mail) ---------------------------------------------------------
# Each channel uses "console" (prints in the server log, local testing only), "twilio" or, for e-mail, "smtp".
WHATSAPP_PROVIDER=console
SMS_PROVIDER=console
EMAIL_PROVIDER=console
# Twilio (WhatsApp + SMS). WHATSAPP_FROM looks like whatsapp:+14155238886 (the sandbox number while testing).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
# SMTP e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# true = never fall back to printing OTPs in the server log (use once a real SMS/e-mail provider works)
OTP_REQUIRE_PROVIDER=false

# --- Daily reminders --------------------------------------------------------------------------------
# Vercel Cron calls /api/jobs/daily with "Authorization: Bearer <CRON_SECRET>" (see vercel.json).
CRON_SECRET=
# Only for local development or an always-on server: run the daily task inside the API process.
ENABLE_LOCAL_SCHEDULER=false
SCHEDULER_HOUR=9

# --- Online rent payment (Razorpay). Leave empty to hide the "Pay online" button. -----------------
# Use the TEST keys from the Razorpay dashboard first. The webhook URL is https://<your-site>/api/gateway/webhook
# with the events payment.captured and order.paid, and the secret you choose below.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
