# Copy values into the Vercel project Environment Variables.
# Do not commit real secrets.

# --- Frontend (build-time) ---
# Leave unset or set to /api so the SPA calls the same-origin Express function.
VITE_API_URL=/api

# --- Backend (runtime) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
JWT_SECRET=replace-with-a-long-random-string
FRONTEND_URL=https://your-app.vercel.app

# Optional: Cloudinary (required only if you upload images/files)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local-only (not used on Vercel)
PORT=5000
JWT_EXPIRES_IN=7d
SETUP_TOKEN=
